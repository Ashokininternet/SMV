<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="400" height="400" viewBox="0 0 400 400">
  <defs>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#0f2b48;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#0a192f;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect width="400" height="400" fill="url(#grad)"/>
  <rect x="20" y="20" width="360" height="360" fill="none" stroke="#d97706" stroke-width="2" stroke-dasharray="8,8" opacity="0.6"/>
  <circle cx="200" cy="180" r="40" fill="#006837" opacity="0.8"/>
  <text x="200" y="188" fill="#ffffff" font-size="24" font-weight="bold" text-anchor="middle" font-family="Segoe UI, sans-serif">SMV</text>
  <text x="200" y="240" fill="#ffffff" font-size="20" font-weight="bold" text-anchor="middle" font-family="Segoe UI, sans-serif">[ Principal / Headmaster Photo ]</text>
  <text x="200" y="265" fill="#f59e0b" font-size="14" text-anchor="middle" font-family="Segoe UI, sans-serif">Replace with Principal official photo</text>
  <text x="200" y="365" fill="#94a3b8" font-size="12" text-anchor="middle" font-family="Segoe UI, sans-serif">Replace with official school photo in /images/</text>
</svg>